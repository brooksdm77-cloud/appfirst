# SmartGrocer NZ Environment Variables

VITE_APP_TITLE="SmartGrocer NZ"
VITE_DEFAULT_PORT=3000

# ── Firebase Authentication and Firestore ──
# Copy these from Firebase Console > Project settings > General > Your apps.
# These are browser app config values, not Firebase Admin credentials.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=smart-shopper-75253
VITE_FIREBASE_APP_ID=

# ── Supermarket Product & Price Data Integration ──
# Option 1: Local Mock Server (start with: npm run mock-api)
# VITE_SUPERMARKET_API_URL=http://localhost:4000

# Option 2: Spread (NZ Supermarket Aggregator API by ButterUp)
# Portal: https://spread.butterup.app
# VITE_SUPERMARKET_API_URL=https://spread.butterup.app/api
# VITE_SPREAD_API_KEY=your_spread_api_key_here

# Option 3: Custom Proxy / Aggregator Endpoint
# VITE_SUPERMARKET_API_URL=https://api.yourdomain.co.nz
